# Configurações opcionais da HarpIA. Copie para .env e ajuste se quiser.
# A HarpIA funciona totalmente offline: nenhuma chave de API externa é necessária.

# Trechos de evidência por resposta (3 a 5). Mais trechos = respostas mais lentas.
# HARPIA_MAX_TRECHOS=3
# Local do índice de conhecimento (SQLite FTS5), separado do banco de conversas.
# HARPIA_INDEX_PATH=
# Tokens máximos por resposta; menos tokens = respostas mais rápidas na CPU.
# HARPIA_RESPONSE_TOKENS=512
